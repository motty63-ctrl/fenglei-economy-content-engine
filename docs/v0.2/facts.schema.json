{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanglei.local/schemas/facts-v2.json",
  "type": "object",
  "required": ["schema_version", "run_id", "checked_at", "policy_version", "summary", "claims"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string"},
    "summary": {"type": "object"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_text", "claim_type", "verification_status", "source_ids", "evidence", "verification_reason", "allowed_downstream"],
        "properties": {
          "claim_id": {"type": "string"},
          "claim_text": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["fact", "opinion", "inference"]},
          "verification_status": {"enum": ["verified", "conflicted", "unverified"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "verification_reason": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "evidence_text", "source_section", "paragraph_locator", "published_at", "retrieved_at", "original_url", "relation"],
              "properties": {
                "source_id": {"type": "string"},
                "evidence_text": {"type": "string", "minLength": 1},
                "source_section": {"type": ["string", "null"]},
                "paragraph_locator": {"type": ["string", "null"]},
                "published_at": {"type": ["string", "null"]},
                "retrieved_at": {"type": "string"},
                "original_url": {"type": "string"},
                "relation": {"enum": ["supports", "contradicts", "context"]}
              }
            }
          }
        }
      }
    }
  }
}
