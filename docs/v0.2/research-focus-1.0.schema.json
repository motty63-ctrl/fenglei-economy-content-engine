{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-focus-1.0.schema.json",
  "title": "Research focus artifact 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "primary_question",
    "subquestions",
    "constraints",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema_version": {"const": "research-focus/1.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "case_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "primary_question": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "created_by": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
