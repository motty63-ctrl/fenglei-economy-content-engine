{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanglei.local/schemas/native-facts-v2.2.json",
  "title": "Native facts runtime contract 2.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "checked_at", "policy_version", "summary", "claims"],
  "properties": {
    "schema_version": {"const": "2.2"},
    "run_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "summary": {"$ref": "#/$defs/summary"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "conflicted", "unverified"],
      "properties": {
        "verified": {"type": "integer", "minimum": 0},
        "conflicted": {"type": "integer", "minimum": 0},
        "unverified": {"type": "integer", "minimum": 0}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_text", "claim_type", "verification_status", "verification_basis", "authority_attestation", "domain", "risk_level", "source_ids", "evidence", "verification_reason", "allowed_downstream", "script_usage"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["fact", "opinion", "inference"]},
        "verification_status": {"enum": ["verified", "conflicted", "unverified"]},
        "verification_basis": {"enum": ["independent_corroboration", "authoritative_primary_attestation", "none"]},
        "authority_attestation": {"anyOf": [{"$ref": "#/$defs/authorityAttestation"}, {"type": "null"}]},
        "domain": {"type": "string", "minLength": 1},
        "risk_level": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "verification_reason": {"type": "string", "minLength": 1},
        "allowed_downstream": {"type": "boolean"},
        "script_usage": {"$ref": "#/$defs/scriptUsage"}
      },
      "allOf": [
        {
          "if": {"properties": {"verification_status": {"const": "verified"}}, "required": ["verification_status"]},
          "then": {
            "properties": {
              "claim_type": {"const": "fact"},
              "verification_basis": {"enum": ["independent_corroboration", "authoritative_primary_attestation"]},
              "script_usage": {"properties": {"status": {"const": "assertion_allowed"}}}
            }
          },
          "else": {
            "properties": {"verification_basis": {"const": "none"}, "allowed_downstream": {"const": false}}
          }
        },
        {
          "if": {"properties": {"allowed_downstream": {"const": true}}, "required": ["allowed_downstream"]},
          "then": {
            "properties": {
              "verification_status": {"const": "verified"},
              "claim_type": {"const": "fact"},
              "verification_basis": {"enum": ["independent_corroboration", "authoritative_primary_attestation"]}
            }
          }
        },
        {
          "if": {"properties": {"verification_basis": {"const": "authoritative_primary_attestation"}}, "required": ["verification_basis"]},
          "then": {"properties": {"authority_attestation": {"$ref": "#/$defs/authorityAttestation"}}},
          "else": {"properties": {"authority_attestation": {"type": "null"}}}
        },
        {
          "if": {"properties": {"verification_status": {"const": "conflicted"}}, "required": ["verification_status"]},
          "then": {"properties": {"script_usage": {"properties": {"status": {"const": "blocked"}}}}}
        },
        {
          "if": {"properties": {"verification_status": {"const": "unverified"}}, "required": ["verification_status"]},
          "then": {
            "properties": {
              "script_usage": {
                "properties": {
                  "status": {"const": "disclosure_only"},
                  "required_label": {"const": "待确认"}
                }
              }
            }
          }
        }
      ]
    },
    "authorityAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_ids", "attribution", "scope"],
      "properties": {
        "kind": {"enum": ["document_report", "deterministic_document_comparison"]},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "attribution": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "measure", "period", "unit", "statistic", "certainty"],
          "properties": {
            "subject": {"type": "string", "minLength": 1},
            "measure": {"type": "string", "minLength": 1},
            "period": {"type": "string", "minLength": 1},
            "unit": {"type": ["string", "null"]},
            "statistic": {"type": ["string", "null"]},
            "certainty": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "deterministic_document_comparison"}}, "required": ["kind"]},
          "then": {"properties": {"source_ids": {"minItems": 2}}}
        }
      ]
    },
    "scriptUsage": {
      "oneOf": [
        {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "assertion_allowed"}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "blocked"}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["status", "reason", "required_label"], "properties": {"status": {"const": "disclosure_only"}, "reason": {"type": "string", "minLength": 1}, "required_label": {"const": "待确认"}}, "additionalProperties": false}
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "evidence_text", "retrieved_at", "original_url", "relation", "evidence_eligible", "eligibility_reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "evidence_text": {"type": "string", "minLength": 1},
        "source_section": {"type": ["string", "null"]},
        "paragraph_locator": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "minLength": 1},
        "original_url": {"type": "string", "minLength": 1},
        "relation": {"enum": ["supports", "contradicts", "context"]},
        "document_hash": {"type": "string"},
        "document_format": {"type": "string"},
        "evidence_origin": {"type": "string"},
        "evidence_eligible": {"type": "boolean"},
        "eligibility_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
